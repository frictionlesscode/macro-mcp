# Local store
SQLITE_PATH=./data/macro.db

# MCP server auth. MCP_PUBLIC_URL is required for correct OAuth redirect URLs once this is
# tunneled -- 127.0.0.1 only works for local-only use.
MCP_BEARER_TOKEN=
MCP_PUBLIC_URL=http://127.0.0.1:18081
OAUTH_STATE_PATH=./data/oauth_state.json

# /dashboard's own secret -- deliberately separate from MCP_BEARER_TOKEN (see README's FAQ).
# Leave unset to disable the dashboard entirely; it fails closed, not open.
DASHBOARD_TOKEN=

# Progress photos (log_body_photo / /dashboard). PHOTO_DIR defaults to a "photos/" sibling of
# SQLITE_PATH if unset. POSE_MODEL_PATH defaults to ./models/pose_landmarker_lite.task --
# the Dockerfile fetches that file at build time; for bare (non-Docker) runs, download it
# yourself (see docs/self-hosted-setup.md) or pose alignment degrades to "unaligned, stored
# anyway" rather than failing.
PHOTO_DIR=
POSE_MODEL_PATH=

# Optional: only used by /dashboard's weight panel (a narrow, read-only call to garmin-mcp --
# see SPEC.md's "Progress photos and dashboard"). Leave blank and the dashboard still works,
# just without a weight line. GARMIN_MCP_TOKEN must match garmin-mcp's own MCP_BEARER_TOKEN --
# macro-mcp completes the same OAuth login garmin-mcp's connector UI does, headlessly.
#
# Running bare (`python -m macro_mcp.server`): 127.0.0.1 below is correct as-is.
# Running via `docker compose up`: change this to http://host.docker.internal:18080/mcp --
# from inside the container, 127.0.0.1 means the container itself, not the host garmin-mcp
# is bound to. Getting this wrong doesn't corrupt anything: the dashboard just reports the
# weight panel unavailable with a connection-error reason instead of a chart.
GARMIN_MCP_URL=http://127.0.0.1:18080/mcp
GARMIN_MCP_TOKEN=
GARMIN_MCP_OAUTH_STATE_PATH=./data/garmin_mcp_oauth.json

# Trend statistics
TREND_MIN_DAYS=7

# Food data (unused until M6)
OFF_ENABLED=true

TZ=America/New_York
LOG_LEVEL=INFO

# Local store
SQLITE_PATH=./data/macro.db

# MCP server auth. MCP_BEARER_TOKEN is macro-mcp's own login password (a different secret
# than GARMIN_MCP_TOKEN below -- this one gates *this* server, GARMIN_MCP_TOKEN is what this
# server presents *to* garmin-mcp). MCP_PUBLIC_URL is required for correct OAuth redirect
# URLs once this is tunneled -- 127.0.0.1 only works for local-only use.
MCP_BEARER_TOKEN=
MCP_PUBLIC_URL=http://127.0.0.1:18081
OAUTH_STATE_PATH=./data/oauth_state.json

# garmin-mcp bridge. GARMIN_MCP_TOKEN must match garmin-mcp's own MCP_BEARER_TOKEN --
# macro-mcp completes the same OAuth login garmin-mcp's connector UI does, headlessly.
#
# Running bare (`python -m macro_mcp.server`): 127.0.0.1 below is correct as-is.
# Running via `docker compose up`: change this to http://host.docker.internal:18080/mcp --
# from inside the container, 127.0.0.1 means the container itself, not the host garmin-mcp
# is bound to. Getting this wrong doesn't corrupt anything: get_expenditure just reports
# tdee: null with a connection-error reason instead of a number, per its degrade-honestly design.
GARMIN_MCP_URL=http://127.0.0.1:18080/mcp
GARMIN_MCP_TOKEN=
GARMIN_MCP_OAUTH_STATE_PATH=./data/garmin_mcp_oauth.json

# Expenditure engine
KCAL_PER_LB=3500
TREND_SMOOTHING_ALPHA=0.15
EXPENDITURE_WINDOW_DAYS=28
EXPENDITURE_MIN_DAYS=14

# Food data (unused until M6)
OFF_ENABLED=true

TZ=America/New_York
LOG_LEVEL=INFO
